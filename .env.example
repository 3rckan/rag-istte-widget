# Copiar a .env y ajustar valores. .env esta en .gitignore, no se versiona.

# "development" (default si no se define) o "production".
# En production, si falta ALLOWED_ORIGINS el servidor NO arranca (fail-closed).
ENTORNO=development

# Dominios permitidos para llamar a /query, separados por coma.
# Sin definir (o vacio) = se permite cualquier origen (solo valido si ENTORNO=development).
ALLOWED_ORIGINS=https://www.istte.edu.ec

# URL donde corre el servidor de Ollama. En local, el default ya funciona.
OLLAMA_BASE_URL=http://localhost:11434
